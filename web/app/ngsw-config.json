{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/icons/*.png",
          "/*.css",
          "/*.js",
          "/audio/*.js"
        ]
      }
    },
    {
      "name": "grids",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/grids/*.json"]
      }
    }
  ]
}
